SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile — captcha no login (Supabase Auth integration)
# Habilitar em Supabase: Authentication → Bot/Abuse Protection → CAPTCHA = Turnstile
# (cole a Secret Key no painel; aqui vai apenas a Site Key publica)
# Opcional em dev: deixe vazio para desabilitar o widget; em prod o Supabase
# rejeita o login sem token quando o captcha esta habilitado no painel.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=


